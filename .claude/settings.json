{
  "permissions": {
    "allow": [
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File *dkj-repo-workflow*new-branch.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File *dkj-repo-workflow*open-pr.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File *dkj-repo-workflow*ship-pr.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File *dkj-repo-workflow*new-branch.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File *dkj-repo-workflow*open-pr.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File *dkj-repo-workflow*ship-pr.ps1*)",
      "Bash(gh repo edit --delete-branch-on-merge*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force-with-lease:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(rm -rf:*)"
    ]
  },
  "enabledPlugins": {
    "dkj-repo-workflow-dkj@dkj-marketplace": true,
    "dkj-repo-workflow@dkj-marketplace": true,
    "dkj-subagents-alpha@dkj-marketplace": true,
    "dkj-subagents-developers@dkj-marketplace": true,
    "dkj-subagents-shopify@dkj-marketplace": false
  }
}
